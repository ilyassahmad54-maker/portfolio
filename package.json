{
  "name": "ilyas-ahmad-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run cms:assets:check && next build",
    "start": "next start",
    "lint": "eslint .",
    "test:auth": "node --test tests/admin-auth.cjs",
    "typecheck": "tsc --noEmit",
    "test:content": "node --test tests/portfolio-content.cjs",
    "test:cms": "node --test tests/cms-*.cjs",
    "cms:schema": "node scripts/cms/generate-schema.cjs",
    "cms:schema:check": "node scripts/cms/generate-schema.cjs --check",
    "cms:migration:dry-run": "node scripts/cms/migration-plan.cjs dry-run",
    "cms:backup:verify": "node scripts/cms/migration-plan.cjs verify-backup",
    "cms:assets": "node scripts/cms/generate-assets.cjs",
    "cms:assets:check": "node scripts/cms/generate-assets.cjs --check",
    "test:browser": "node --test tests/browser/portfolio.cjs",
    "cms:preview:prepare": "node scripts/cms/prepare-preview.cjs",
    "cms:preview:seed": "node scripts/cms/seed-preview.cjs",
    "cms:preview:check": "node scripts/cms/check-preview.cjs",
    "test:integration": "node --test tests/integration/preview.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.475.0",
    "next": "^15.5.27",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-type-animation": "^3.2.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "playwright-core": "^1.58.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "postcss-selector-parser": "^7.1.6"
  }
}
