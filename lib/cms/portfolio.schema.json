{
  "type": "object",
  "properties": {
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 500
        },
        "headline": {
          "type": "string",
          "maxLength": 500
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 200
        },
        "location": {
          "type": "string",
          "maxLength": 500
        },
        "email": {
          "type": "string",
          "maxLength": 320,
          "format": "email"
        },
        "phone": {
          "type": "string",
          "maxLength": 80
        },
        "statusBadge": {
          "type": "string",
          "maxLength": 500
        },
        "summary": {
          "type": "string",
          "maxLength": 20000
        },
        "aboutParagraphs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          },
          "maxItems": 200
        },
        "cvUrl": {
          "type": "string",
          "maxLength": 2048,
          "format": "cv-path"
        },
        "profileImage": {
          "type": "string",
          "maxLength": 2048,
          "format": "image-ref"
        },
        "formspreeEndpoint": {
          "type": "string",
          "maxLength": 2048,
          "format": "formspree"
        }
      },
      "required": [
        "name",
        "headline",
        "roles",
        "location",
        "email",
        "phone",
        "statusBadge",
        "summary",
        "aboutParagraphs",
        "cvUrl",
        "profileImage",
        "formspreeEndpoint"
      ],
      "additionalProperties": false
    },
    "socialLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "maxLength": 20,
            "enum": [
              "github",
              "linkedin",
              "email",
              "phone"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 500
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "social-link"
          },
          "username": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "platform",
          "label",
          "url",
          "username"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "stats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 500
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "suffix": {
            "type": "string",
            "maxLength": 500
          },
          "description": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "label",
          "value",
          "suffix",
          "description"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "category": {
            "type": "string",
            "maxLength": 500
          },
          "description": {
            "type": "string",
            "maxLength": 20000
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 500
                },
                "icon": {
                  "type": "string",
                  "maxLength": 500
                },
                "highlighted": {
                  "type": "boolean"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            "maxItems": 200
          }
        },
        "required": [
          "id",
          "category",
          "description",
          "skills"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "role": {
            "type": "string",
            "maxLength": 500
          },
          "company": {
            "type": "string",
            "maxLength": 500
          },
          "location": {
            "type": "string",
            "maxLength": 500
          },
          "period": {
            "type": "string",
            "maxLength": 500
          },
          "current": {
            "type": "boolean"
          },
          "description": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            },
            "maxItems": 200
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 200
          }
        },
        "required": [
          "id",
          "role",
          "company",
          "location",
          "period",
          "description",
          "technologies"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "category": {
            "type": "string",
            "maxLength": 100,
            "enum": [
              "AI & Computer Vision",
              "Machine Learning",
              "Data Analytics & Viz"
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 20000
          },
          "description": {
            "type": "string",
            "maxLength": 20000
          },
          "image": {
            "type": "string",
            "maxLength": 2048,
            "format": "image-ref"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 200
          },
          "githubUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "web-link"
          },
          "demoUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "web-link"
          },
          "liveDemoUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "web-link"
          },
          "featured": {
            "type": "boolean"
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            },
            "maxItems": 200
          }
        },
        "required": [
          "id",
          "title",
          "slug",
          "category",
          "summary",
          "description",
          "image",
          "tags",
          "githubUrl",
          "demoUrl",
          "featured",
          "highlights"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "degree": {
            "type": "string",
            "maxLength": 500
          },
          "institution": {
            "type": "string",
            "maxLength": 500
          },
          "location": {
            "type": "string",
            "maxLength": 500
          },
          "period": {
            "type": "string",
            "maxLength": 500
          },
          "gpa": {
            "type": "string",
            "maxLength": 500
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            },
            "maxItems": 200
          }
        },
        "required": [
          "id",
          "degree",
          "institution",
          "location",
          "period",
          "gpa",
          "details"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "issuer": {
            "type": "string",
            "maxLength": 500
          },
          "date": {
            "type": "string",
            "maxLength": 500
          },
          "credentialUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "web-link"
          },
          "skillsLearned": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 200
          }
        },
        "required": [
          "id",
          "title",
          "issuer",
          "date",
          "skillsLearned"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "navItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 500
          },
          "href": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^#[a-z][a-z0-9-]*$"
          }
        },
        "required": [
          "label",
          "href"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    }
  },
  "required": [
    "profile",
    "socialLinks",
    "stats",
    "skills",
    "experience",
    "projects",
    "education",
    "certifications",
    "navItems"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-content-v1"
}
